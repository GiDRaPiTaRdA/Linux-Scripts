{
  "Name": "CheatShell",
  "Description": "Install, update, and edit CheatShell configuration files.",
  "Children": [
    {
      "Name": "Update CheatShell from GitHub",
      "Description": "Download the latest script, check its syntax, and install it system-wide.",
      "Command": [
        "tmp=$(mktemp) &&",
        "trap 'rm -f \"$tmp\"' EXIT &&",
        "curl -fL https://raw.githubusercontent.com/GiDRaPiTaRdA/Linux-Scripts/master/cheatshell/cheatshell.py -o \"$tmp\" &&",
        "python3 -m py_compile \"$tmp\" &&",
        "sudo install -m 755 \"$tmp\" /usr/local/bin/cheatshell"
      ]
    },
    {
      "Name": "Update CheatShell menu from GitHub",
      "Description": "Download and validate the latest management menu; ask before replacing the installed menu.",
      "Command": [
        "tmp=$(mktemp) &&",
        "trap 'rm -f \"$tmp\"' EXIT &&",
        "curl -fL https://raw.githubusercontent.com/GiDRaPiTaRdA/Linux-Scripts/master/cheatshell/cheatshell-menu.json -o \"$tmp\" &&",
        "python3 -m json.tool \"$tmp\" >/dev/null &&",
        "read -r -p 'Replace installed CheatShell menu? [y/N] ' confirm &&",
        "[[ \"$confirm\" == [yY] ]] &&",
        "sudo install -D -m 644 \"$tmp\" /etc/cheatshell/cheatshell-menu.json"
      ]
    },
    {
      "Name": "Create project cheatfile",
      "Description": "Download the example into the current folder if missing, then open with nano.",
      "Command": [
        "if [ ! -e cheatfile.json ]; then",
        "curl -fL https://raw.githubusercontent.com/GiDRaPiTaRdA/Linux-Scripts/master/cheatshell/cheatfile.example.json -o cheatfile.json || exit 1;",
        "fi;",
        "nano cheatfile.json"
      ]
    },
    {
      "Name": "Download system cheatfile",
      "Description": "Download and validate the system cheatfile; ask before replacing an existing file.",
      "Command": [
        "tmp=$(mktemp) &&",
        "trap 'rm -f \"$tmp\"' EXIT &&",
        "curl -fL https://raw.githubusercontent.com/GiDRaPiTaRdA/Linux-Scripts/master/cheatshell/system-cheatfile.json -o \"$tmp\" &&",
        "python3 -m json.tool \"$tmp\" >/dev/null &&",
        "if [ -e /etc/cheatshell/cheatfile.json ]; then",
        "read -r -p 'Replace existing system cheatfile? [y/N] ' confirm;",
        "[[ \"$confirm\" == [yY] ]] || exit 0;",
        "fi;",
        "sudo install -D -m 644 \"$tmp\" /etc/cheatshell/cheatfile.json"
      ]
    },
    {
      "Name": "Open project cheatfile",
      "Description": "Edit ./cheatfile.json in nano.",
      "Command": "nano ./cheatfile.json"
    },
    {
      "Name": "Open system cheatfile",
      "Description": "Edit /etc/cheatshell/cheatfile.json in nano with sudo.",
      "Command": "sudo nano /etc/cheatshell/cheatfile.json"
    }
  ]
}
